#!/bin/sh
set -eu

remote_name="${1:-}"
remote_url="${2:-}"
current_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"

case "$remote_name:$remote_url" in
    upstream:*|*:https://github.com/spruceUI/spruceOS.git|*:git@github.com:spruceUI/spruceOS.git)
        echo "ERROR: upstream is fetch-only for this harness checkout. Push to origin only." >&2
        exit 1
        ;;
esac

if [ "$current_branch" = "catalyticarkun/spruceos-harness" ] &&
   [ "$remote_name" != "origin" ]; then
    echo "ERROR: catalyticarkun/spruceos-harness may only be pushed to origin." >&2
    exit 1
fi

exit 0
